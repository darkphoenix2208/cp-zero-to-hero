{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/flashback/layout,_N_T_/flashback/page,_N_T_/flashback"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/flashback/__PAGE__",
    "/flashback",
    "/_index",
    "/_head"
  ]
}